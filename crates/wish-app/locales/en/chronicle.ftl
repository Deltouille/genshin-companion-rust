# The chronicle: the Spiral Abyss, the Imaginarium Theater and the Traveler’s Diary, which HoYoLAB shows for a while only, kept here.

chronicle-abyss = Spiral Abyss
chronicle-theater = Imaginarium Theater
chronicle-diary = Traveler’s Diary
chronicle-period = Period
chronicle-range = { $from } – { $to }
chronicle-kept = Kept from HoYoLAB on { $date }.
chronicle-kept-under-way = Kept from HoYoLAB on { $date }, while under way: the next sync brings it up to date.
chronicle-level = Lv. { $level }
chronicle-one-period = One period kept so far: the chart starts with the next.
chronicle-unreadable = { $count ->
        [one] One period was kept by a newer version of the app and can’t be read here; it stays kept.
       *[other] { $count } periods were kept by a newer version of the app and can’t be read here; they stay kept.
    }

## Before anything is kept

chronicle-empty-abyss = No Spiral Abyss kept yet
chronicle-empty-theater = No Imaginarium Theater kept yet
chronicle-empty-diary = No Traveler’s Diary kept yet
chronicle-empty-help = HoYoLAB shows the Spiral Abyss and the Imaginarium Theater of the period under way and the one before, and the Traveler’s Diary of this month and the two before; then they are gone. Sync from HoYoLAB to keep them here for good, then once a month, so none is missed.

